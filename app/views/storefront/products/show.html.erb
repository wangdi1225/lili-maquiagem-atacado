<% content_for(:title) { @product.name } %>
<% media_list = product_media(@product) %>
<nav class="text-sm text-gray-500 mb-3">
  <%= link_to "Início", root_path %> ›
  <% if (t = @product.taxons.first) %><%= link_to t.name, storefront_taxon_path(slug: t.slug.sub(/^[^\/]+\//, '')) %> ›<% end %>
  <%= @product.name %>
</nav>
<div class="grid md:grid-cols-2 gap-8 bg-white rounded-2xl shadow-sm p-6">
  <div id="product-gallery" data-gallery>
    <% if media_list.any? %>
      <div id="gallery-main" class="mb-3">
        <%= render_media_image(media_list.first, media_list.first.alt.presence || @product.name,
              css: "w-full rounded-xl object-cover aspect-square bg-white",
              size: :large, eager: true,
              sizes_attr: "(max-width: 768px) 100vw, 560px",
              html: { data: { gallery_main: true } }) %>
      </div>
      <% if media_list.size > 1 %>
        <div class="grid grid-cols-4 gap-2">
          <% media_list.each_with_index do |m, i| %>
            <button type="button" data-gallery-thumb
                    data-full="<%= main_app.rails_representation_path(media_variant(m, :large)) %>"
                    aria-label="Ver imagem <%= i + 1 %>"
                    class="gallery-thumb rounded-lg overflow-hidden ring-2 <%= i.zero? ? 'ring-pink-500' : 'ring-transparent hover:ring-pink-300' %>">
              <%= render_media_image(m, @product.name, css: "w-full aspect-square object-cover bg-white", size: :small, sizes_attr: "120px") %>
            </button>
          <% end %>
        </div>
      <% end %>
    <% else %>
      <%= product_image(@product, css: "w-full rounded-xl object-cover aspect-square") %>
    <% end %>
  </div>
  <div class="lg:sticky lg:top-4 self-start">
    <h1 class="text-2xl font-bold mb-2"><%= @product.name %></h1>
    <div class="flex items-center gap-2 flex-wrap mb-3">
      <span class="text-xs text-gray-400">COD: <%= @product.sku %></span>
      <% @product.taxons.each do |t| %>
        <%= link_to t.name, storefront_taxon_path(slug: t.permalink.sub(/^[^\/]+\//, '')), class: "text-[11px] bg-gray-100 text-gray-600 rounded-full px-2 py-0.5 hover:bg-pink-50 hover:text-pink-700" %>
      <% end %>
    </div>
    <p class="text-gray-600 text-sm mb-4 whitespace-pre-line"><%= @product.description %></p>
    <table class="w-full text-sm border rounded-lg overflow-hidden mb-4">
      <tbody class="divide-y">
        <tr class="bg-gray-50"><td class="px-3 py-1.5 text-gray-500">Preço por barra/kit</td><td class="px-3 py-1.5 font-semibold text-pink-600"><%= brl(product_min_price(@product)) %></td></tr>
        <% if (n = pack_unit_count(@product)) && (up = unit_price(@product)) %>
          <tr><td class="px-3 py-1.5 text-gray-500">Preço por unidade</td><td class="px-3 py-1.5"><%= brl(up) %> (<%= n %> un por barra)</td></tr>
        <% end %>
        <tr class="bg-gray-50"><td class="px-3 py-1.5 text-gray-500">Pedido mínimo</td><td class="px-3 py-1.5"><%= brl(wholesale_min_total) %> por compra</td></tr>
      </tbody>
    </table>

    <h2 class="font-semibold mb-2">Opções e preços (atacado)</h2>
    <div class="divide-y border rounded-lg">
      <% @variants.each do |v| %>
        <div class="p-3 flex items-center gap-3">
          <div class="flex-1">
            <p class="text-sm font-medium"><%= variant_label(v) %></p>
            <p class="text-pink-600 font-bold"><%= brl(variant_price(v) || 0) %></p>
          </div>
          <%= form_with url: "/cart/add", method: :post, class: "flex items-center gap-2" do |f| %>
            <%= f.hidden_field :variant_id, value: v.id %>
            <%= f.number_field :quantity, value: 1, min: 1, class: "w-16 border rounded px-2 py-1 text-sm" %>
            <%= f.submit "Adicionar", class: "bg-pink-600 text-white text-sm px-3 py-1.5 rounded-full hover:bg-pink-700 cursor-pointer" %>
          <% end %>
        </div>
      <% end %>
    </div>

    <p class="text-xs text-gray-500 mt-4">Pedido mínimo de <%= brl(wholesale_min_total) %> por compra. Sem pagamento online: você envia o pedido pelo WhatsApp e combinamos PIX/transferência.</p>
    <a href="https://wa.me/<%= default_whatsapp %>?text=<%= ERB::Util.url_encode("Olá! Tenho interesse no produto: #{@product.name}") %>" target="_blank" rel="noopener" class="inline-block mt-3 bg-green-500 text-white text-sm px-4 py-2 rounded-full hover:bg-green-600">Perguntar sobre este produto</a>
  </div>
</div>

<% if media_list.size > 1 %>
<script>
  (function () {
    var root = document.getElementById('product-gallery');
    if (!root) return;
    var main = root.querySelector('[data-gallery-main]');
    root.querySelectorAll('[data-gallery-thumb]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var full = btn.getAttribute('data-full');
        if (main) {
          main.setAttribute('src', full);
          main.removeAttribute('srcset');
        }
        root.querySelectorAll('.gallery-thumb').forEach(function (t) {
          t.classList.remove('ring-pink-500'); t.classList.add('ring-transparent');
        });
        btn.classList.add('ring-pink-500'); btn.classList.remove('ring-transparent');
      });
    });
  })();
</script>
<% end %>
