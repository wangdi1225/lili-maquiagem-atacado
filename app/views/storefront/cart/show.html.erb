<% content_for(:title) { "Carrinho" } %>
<h1 class="text-2xl font-bold mb-4">Carrinho de compra</h1>
<% if current_order.nil? || current_order.line_items.empty? %>
  <div class="bg-white rounded-xl p-8 text-center shadow-sm">
    <p class="text-gray-500 mb-4">Seu carrinho está vazio.</p>
    <%= link_to "Ver produtos", root_path, class: "bg-pink-600 text-white px-4 py-2 rounded-full text-sm hover:bg-pink-700" %>
  </div>
<% else %>
  <% remaining = wholesale_min_total - current_order.item_total %>
  <div class="bg-white rounded-xl shadow-sm overflow-hidden">
    <table class="w-full text-sm">
      <thead class="bg-gray-50 text-left text-gray-500">
        <tr><th class="p-3">Produto</th><th class="p-3">Opção</th><th class="p-3">Preço</th><th class="p-3">Qtd.</th><th class="p-3">Subtotal</th><th class="p-3"></th></tr>
      </thead>
      <tbody class="divide-y">
        <% current_order.line_items.each do |li| %>
          <tr>
            <td class="p-3"><%= link_to li.name, storefront_product_path(slug: li.product.slug), class: "hover:text-pink-600" %></td>
            <td class="p-3 text-gray-500"><%= variant_label(li.variant) %></td>
            <td class="p-3"><%= brl(li.price) %><% if (up = unit_price(li.product)) %><span class="block text-[11px] text-gray-400">≈ <%= brl(up) %>/un</span><% end %></td>
            <td class="p-3">
              <div class="flex items-center gap-1">
                <%= link_to "−", storefront_cart_set_path(id: li.id, qty: li.quantity - 1), class: "w-7 h-7 rounded-full border border-gray-300 flex items-center justify-center hover:bg-gray-100" %>
                <%= form_with url: "/cart/update", method: :patch, class: "flex gap-1" do |f| %>
                  <%= f.hidden_field :line_item_id, value: li.id %>
                  <%= f.number_field :quantity, value: li.quantity, min: 0, class: "w-14 border rounded px-2 py-1 text-center" %>
                  <%= f.submit "OK", class: "bg-gray-100 border rounded px-2 py-1 hover:bg-gray-200 cursor-pointer" %>
                <% end %>
                <%= link_to "+", storefront_cart_set_path(id: li.id, qty: li.quantity + 1), class: "w-7 h-7 rounded-full border border-gray-300 flex items-center justify-center hover:bg-gray-100" %>
              </div>
            </td>
            <td class="p-3 font-semibold"><%= brl(li.price * li.quantity) %></td>
            <td class="p-3">
              <%= button_to "✕", storefront_cart_remove_path(id: li.id), method: :delete, class: "text-gray-400 hover:text-red-600 cursor-pointer" %>
            </td>
          </tr>
        <% end %>
      </tbody>
      <tfoot>
        <tr class="bg-gray-50 font-bold">
          <td colspan="4" class="p-3 text-right">Total</td>
          <td class="p-3 text-pink-600"><%= brl(current_order.item_total) %></td>
          <td></td>
        </tr>
      </tfoot>
    </table>
  </div>
  <% cart_ids = current_order.line_items.map(&:variant_id) %>
  <% suggestions = Spree::Product.available.where.not(id: current_order.line_items.map(&:product_id)).joins(master: :prices).where(spree_prices: { currency: 'BRL' }).order('spree_prices.amount ASC').distinct.limit(4) %>
  <% if suggestions.any? %>
    <h2 class="text-lg font-bold mt-8 mb-3">Complete seu pedido</h2>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      <%= render partial: "storefront/shared/product_card", collection: suggestions, as: :product %>
    </div>
  <% end %>

  <div class="mt-4 bg-white rounded-xl shadow-sm p-4">
    <% pct = [(current_order.item_total / wholesale_min_total * 100), 100].min %>
    <div class="flex justify-between text-xs text-gray-500 mb-1">
      <span>Progresso do pedido mínimo</span>
      <span><%= brl(current_order.item_total) %> / <%= brl(wholesale_min_total) %></span>
    </div>
    <div class="w-full bg-gray-100 rounded-full h-2 mb-4">
      <div class="bg-pink-500 h-2 rounded-full" style="width: <%= pct %>%"></div>
    </div>
    <div class="flex items-center gap-3 flex-wrap">
      <% if remaining > 0 %>
        <p class="text-sm text-amber-700 bg-amber-100 px-3 py-2 rounded">Faltam <%= brl(remaining) %> para atingir o pedido mínimo de <%= brl(wholesale_min_total) %> e liberar o checkout.</p>
        <a href="<%= whatsapp_quote_link(current_order) %>" target="_blank" rel="noopener" class="bg-green-500 text-white px-4 py-2.5 rounded-full font-semibold hover:bg-green-600">📲 Enviar carrinho como cotação no WhatsApp</a>
      <% else %>
        <%= link_to "Finalizar pedido →", storefront_checkout_path, class: "bg-pink-600 text-white px-5 py-2.5 rounded-full font-semibold hover:bg-pink-700" %>
        <a href="<%= whatsapp_quote_link(current_order) %>" target="_blank" rel="noopener" class="text-sm text-green-700 hover:underline">ou enviar como cotação no WhatsApp</a>
      <% end %>
      <%= link_to "Continuar comprando", root_path, class: "text-sm text-gray-500 hover:text-pink-600" %>
    </div>
    <p class="text-xs text-gray-400 mt-3">Sem pagamento online: o pedido/cotação é confirmado pelo nosso time no WhatsApp (PIX/transferência).</p>
  </div>
<% end %>
