<% content_for(:title) { "Busca: #{@q}" } %>
<div class="flex items-center gap-3 flex-wrap mb-4">
  <h1 class="text-2xl font-bold">Busca: "<%= @q %>"</h1>
  <span class="text-sm text-gray-400"><%= @count %> resultado(s)</span>
  <%= form_with url: storefront_search_path, method: :get, class: "ml-auto flex items-center gap-2" do |f| %>
    <%= f.hidden_field :q, value: @q %>
    <%= f.select :sort, options_for_select([["Ordenar: recentes", ""], ["Nome", "name"], ["Menor preço", "price_asc"], ["Maior preço", "price_desc"]], @sort), {}, class: "border rounded-full px-3 py-1.5 text-sm bg-white", onchange: "this.form.requestSubmit()" %>
  <% end %>
</div>
<% if @products.any? %>
  <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
    <%= render partial: "storefront/shared/product_card", collection: @products, as: :product %>
  </div>
<% else %>
  <div class="bg-white rounded-xl p-8 text-center shadow-sm">
    <p class="text-gray-500 mb-4">Nenhum produto encontrado para "<%= @q %>".</p>
    <%= link_to "Ver todos os produtos", root_path, class: "bg-pink-600 text-white px-4 py-2 rounded-full text-sm hover:bg-pink-700" %>
  </div>
<% end %>
<%= render partial: "storefront/shared/pager" %>
