<% quick_variant = product.variants.order(:position).first || product.master %>
<div class="relative bg-white rounded-xl shadow-sm overflow-hidden hover:shadow-md transition">
  <%= link_to storefront_product_path(slug: product.slug), class: "block" do %>
    <%= product_image(product) %>
    <div class="p-3 pr-12">
      <% if (b = brand_of(product)) %><span class="inline-block text-[10px] uppercase tracking-wide bg-pink-50 text-pink-700 border border-pink-100 rounded px-1.5 py-0.5 mb-1"><%= b.name %></span><% end %>
      <p class="text-sm font-medium line-clamp-2 h-10"><%= product.name %></p>
      <p class="text-pink-600 font-bold mt-1"><%= brl(product_min_price(product)) %></p>
      <p class="text-xs text-gray-400">
        <% if (up = unit_price(product)) %>≈ <%= brl(up) %>/un · <%= pack_unit_count(product) %> un<% else %>preço por barra/kit<% end %>
      </p>
    </div>
  <% end %>
  <%= form_with url: "/cart/add", method: :post, class: "absolute bottom-3 right-3" do |f| %>
    <%= f.hidden_field :variant_id, value: quick_variant.id %>
    <%= f.hidden_field :quantity, value: 1 %>
    <%= f.submit "+", title: "Adicionar 1 ao carrinho", class: "w-9 h-9 rounded-full bg-pink-600 text-white text-xl font-bold cursor-pointer hover:bg-pink-700 leading-none" %>
  <% end %>
</div>
