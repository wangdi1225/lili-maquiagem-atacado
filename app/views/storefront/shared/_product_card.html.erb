<%= link_to storefront_product_path(slug: product.slug), class: "bg-white rounded-xl shadow-sm overflow-hidden hover:shadow-md transition block" do %>
  <%= product_image(product) %>
  <div class="p-3">
    <p class="text-sm font-medium line-clamp-2 h-10"><%= product.name %></p>
    <p class="text-pink-600 font-bold mt-1"><%= brl(product_min_price(product)) %></p>
    <p class="text-xs text-gray-400">preço por barra/kit</p>
  </div>
<% end %>
