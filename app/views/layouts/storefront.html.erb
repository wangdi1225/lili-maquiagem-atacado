<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <title><%= content_for?(:title) ? "#{yield(:title)} — Lili Maquiagem Atacado" : "Lili Maquiagem Atacado" %></title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 text-gray-900">
<header class="bg-white shadow">
  <div class="max-w-6xl mx-auto px-4 py-3 flex items-center gap-6">
    <%= link_to root_path, class: "text-xl font-extrabold text-pink-600 whitespace-nowrap" do %>💄 Lili Maquiagem <span class="text-gray-500 font-medium text-sm">Atacado</span><% end %>
    <nav class="hidden md:flex gap-4 text-sm flex-wrap">
      <% root_taxons.each do |t| %>
        <%= link_to t.name, storefront_taxon_path(slug: t.slug.sub(/^[a-z0-9-]+\//, '')), class: "hover:text-pink-600" %>
      <% end %>
    </nav>
    <div class="ml-auto">
      <%= link_to storefront_cart_path, class: "inline-flex items-center gap-1 bg-pink-600 text-white text-sm px-3 py-1.5 rounded-full hover:bg-pink-700" do %>
        🛒 Carrinho
        <% if current_order && current_order.line_items.any? %>
          <span class="bg-white text-pink-600 rounded-full px-1.5 font-bold"><%= current_order.line_items.sum(:quantity) %></span>
        <% end %>
      <% end %>
    </div>
  </div>
</header>
<main class="max-w-6xl mx-auto px-4 py-6">
  <% flash.each do |type, msg| %>
    <div class="mb-4 px-4 py-3 rounded text-sm <%= type.to_s == 'alert' || type.to_s == 'error' ? 'bg-red-100 text-red-800' : 'bg-green-100 text-green-800' %>"><%= msg %></div>
  <% end %>
  <%= yield %>
</main>
<footer class="mt-10 border-t bg-white">
  <div class="max-w-6xl mx-auto px-4 py-6 text-sm text-gray-500 flex flex-wrap items-center gap-4">
    <span>© <%= Date.today.year %> Lili Maquiagem Atacado — venda exclusiva para lojistas (CNPJ).</span>
    <span class="ml-auto">Pedido mínimo: <%= brl(wholesale_min_total) %></span>
    <a href="https://wa.me/<%= default_whatsapp %>" target="_blank" rel="noopener" class="bg-green-500 text-white px-3 py-1.5 rounded-full hover:bg-green-600">Falar no WhatsApp</a>
  </div>
</footer>
</body>
</html>
